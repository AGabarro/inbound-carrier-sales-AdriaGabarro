# Copy to .env and fill in. Never commit .env.
# production (default): real bookings. development: bookings are checked but never sent to the TMS.
APP_ENV=production
TMS_HOST=tramway.proxy.rlwy.net
TMS_PORT=17159
TMS_TOKEN=
FMCSA_API_KEY=
# Key the HappyRobot workflow sends in the X-API-Key header. Generate a long random string.
API_KEY=
# Contact on file per MC for one-time codes (demo carriers): 133655:you@example.com,650000:you@example.com
CARRIER_CONTACTS=
# HappyRobot "OTP Sender" workflow webhook (trigger panel). Empty = codes are not delivered.
OTP_SENDER_WEBHOOK_URL=
OTP_SENDER_API_KEY=
